# Server
PORT=3000
# Basic-Auth fuer das Web-UI (Tool liegt oeffentlich auf einem Server!)
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=change-me

# Anthropic (Gameplan-Text, Upgrade-Einzeiler, Caption)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Scryfall braucht keinen Key. Moxfield/Archidekt-Import brauchen keinen Key.

# Datenablage
DATA_DIR=./data
OUT_DIR=./out
