# Server
PORT=3000
# Basic-Auth fuer das Web-UI (Tool liegt oeffentlich auf einem Server!)
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=change-me

# Anthropic (Gameplan-Text, Upgrade-Einzeiler, Caption)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Scryfall braucht keinen Key. Moxfield-Import braucht keinen Key.

# S3 / Cloudflare R2 (Zwischenspeicher fuer Instagram-Upload)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=mtg-insta-tool
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Oeffentliche Basis-URL, unter der Bucket-Objekte erreichbar sind
# (R2 Public Bucket URL oder eigene Domain/CDN vor dem Bucket)
S3_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

# Instagram Graph API
IG_USER_ID=
IG_ACCESS_TOKEN=

# Datenablage
DATA_DIR=./data
OUT_DIR=./out
