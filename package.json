{
  "name": "mtg-insta-tool",
  "version": "0.1.0",
  "description": "MTG Commander Deck-Tech Instagram-Carousel-Generator mit Scheduling und optionalem Auto-Publish",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "generate": "ts-node src/cli.ts generate",
    "publish-now": "ts-node src/cli.ts publish"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@aws-sdk/client-s3": "^3.699.0",
    "@aws-sdk/s3-request-presigner": "^3.699.0",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lowdb": "^1.0.0",
    "mana-font": "^1.15.0",
    "node-cron": "^3.0.3",
    "nanoid": "^3.3.7",
    "puppeteer": "^23.10.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/lowdb": "^1.0.15",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  },
  "allowScripts": {
    "puppeteer@23.11.1": true
  }
}
